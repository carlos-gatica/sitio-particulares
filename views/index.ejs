<%- include('partials/header') %>

<section class="hero">
  <div class="contenedor hero__interior">
    <p class="hero__ficha">FICHA DE OFICIO — TRABAJOS PARA EL HOGAR</p>
    <h1 class="hero__titulo">Arreglamos lo que tu casa necesita, bien hecho y sin vueltas.</h1>
    <p class="hero__subtitulo">Pintura, gasfitería, electricidad y remodelaciones para particulares. Pides una cotización, te contactamos, coordinamos visita.</p>
    <a href="#cotizar" class="boton boton--primario">Pedir cotización ahora</a>
  </div>
</section>

<section id="servicios" class="servicios">
  <div class="contenedor">
    <h2 class="seccion__titulo">Nuestros servicios</h2>
    <div class="servicios__grilla">
      <% servicios.forEach(function(s) { %>
        <a href="/servicio/<%= s.slug %>" class="ficha-servicio">
          <img src="/public/img/iconos/<%= s.icono %>" alt="" class="ficha-servicio__icono" />
          <h3 class="ficha-servicio__titulo"><%= s.titulo %></h3>
          <p class="ficha-servicio__resumen"><%= s.resumen %></p>
          <span class="ficha-servicio__link">Ver detalle →</span>
        </a>
      <% }); %>
    </div>
  </div>
</section>

<section id="cotizar" class="cotizar">
  <div class="contenedor cotizar__interior">
    <div class="cotizar__intro">
      <p class="hero__ficha">SOLICITAR</p>
      <h2 class="seccion__titulo">Pide tu cotización</h2>
      <p>Cuéntanos qué necesitas y te contactamos por correo o WhatsApp.</p>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <p class="formulario__error"><%= error %></p>
    <% } %>

    <form action="/cotizacion" method="POST" class="formulario">
      <label class="formulario__campo">
        <span>Nombre completo *</span>
        <input type="text" name="nombre" required>
      </label>

      <label class="formulario__campo">
        <span>Teléfono *</span>
        <div class="formulario__telefono">
          <span class="formulario__prefijo">+569</span>
          <input type="tel" name="telefono" placeholder="12345678" pattern="[0-9]{8}" required>
        </div>
      </label>

      <label class="formulario__campo">
        <span>Correo electrónico *</span>
        <input type="email" name="correo" required>
      </label>

      <label class="formulario__campo">
        <span>Servicio de interés</span>
        <select name="servicio_slug">
          <option value="">Selecciona (opcional)</option>
          <% servicios.forEach(function(s) { %>
            <option value="<%= s.slug %>"><%= s.titulo %></option>
          <% }); %>
        </select>
      </label>

      <label class="formulario__campo formulario__campo--ancho">
        <span>Cuéntanos qué necesitas *</span>
        <textarea name="descripcion" rows="4" required></textarea>
      </label>

      <button type="submit" class="boton boton--primario formulario__enviar">Enviar solicitud</button>
    </form>
  </div>
</section>

<%- include('partials/footer') %>
