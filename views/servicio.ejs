<%- include('partials/header') %>
<section class="servicio-hero">
  <div class="contenedor">
    <a href="/#servicios" class="servicio-hero__volver">← Todos los servicios</a>
    <p class="hero__ficha">SERVICIO</p>
    <h1 class="hero__titulo"><%= servicio.titulo %></h1>
    <p class="hero__subtitulo"><%= servicio.resumen %></p>
  </div>
</section>

<section class="servicio-detalle">
  <div class="contenedor servicio-detalle__grilla">
    <div class="servicio-detalle__texto">
      <% if (servicio.parrafos.length) { %>
        <h2 class="seccion__titulo seccion__titulo--chico">Qué hacemos</h2>
        <% servicio.parrafos.forEach(function(parrafo) { %>
          <p><%= parrafo %></p>
        <% }); %>
      <% } %>

      <% if (servicio.lista.length) { %>
        <h2 class="seccion__titulo seccion__titulo--chico">Qué incluye</h2>
        <ul class="lista-incluye">
          <% servicio.lista.forEach(function(item) { %>
            <li><%= item %></li>
          <% }); %>
        </ul>
      <% } %>
    </div>

    <aside class="servicio-detalle__cta">
      <div class="ficha-cta">
        <h3>¿Necesitas este servicio?</h3>
        <p>Pide una cotización y te contactamos a la brevedad.</p>
        <a href="/?servicio=<%= servicio.slug %>#cotizar" class="boton boton--primario">Pedir cotización</a>
      </div>
    </aside>
  </div>
</section>

<section id="portafolio" class="portafolio">
  <div class="contenedor">
    <h2 class="seccion__titulo">Proyectos realizados</h2>

    <% if (portafolio && portafolio.length) { %>
      <div class="portafolio__grilla">
        <% portafolio.forEach(function(p) { %>
          <figure class="portafolio__item">
            <button type="button" class="portafolio__abrir" data-lightbox data-grupo="portafolio"
                    data-tipo="<%= p.media_tipo %>" data-url="<%= p.media_url %>" data-titulo="<%= p.titulo || '' %>"
                    aria-label="Ver <%= p.titulo || 'proyecto' %> en grande">
              <%- include('partials/miniatura', { url: p.media_url, tipo: p.media_tipo, alt: p.titulo || ('Proyecto de ' + servicio.titulo), clase: 'portafolio__media' }) %>
              <% if (p.media_tipo !== 'imagen') { %><span class="portafolio__play" aria-hidden="true">▶</span><% } %>
            </button>
            <% if (p.titulo || p.descripcion) { %>
              <figcaption class="portafolio__texto">
                <% if (p.titulo) { %><strong><%= p.titulo %></strong><% } %>
                <% if (p.descripcion) { %><span><%= p.descripcion %></span><% } %>
              </figcaption>
            <% } %>
          </figure>
        <% }); %>
      </div>
    <% } else { %>
      <p class="portafolio__vacio">Estamos preparando la galería de proyectos de este servicio. Mientras tanto, cuéntanos qué necesitas y te enviamos ejemplos de trabajos similares.</p>
    <% } %>
  </div>
</section>

<section class="otros-servicios">
  <div class="contenedor">
    <h2 class="seccion__titulo seccion__titulo--chico">Otros servicios</h2>
    <div class="otros-servicios__lista">
      <% servicios.filter(function(s) { return s.slug !== servicio.slug; }).forEach(function(s) { %>
        <a href="/servicio/<%= s.slug %>" class="otros-servicios__item"><%= s.titulo %></a>
      <% }); %>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
