<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Cotizaciones — <%= siteName %></title>
  <link rel="stylesheet" href="/public/css/estilos.css">
</head>
<body class="admin">
  <header class="cabecera">
    <div class="contenedor cabecera__interior">
      <span class="cabecera__marca">Panel admin — <%= siteName %></span>
    </div>
  </header>

  <main class="contenedor admin__contenido">
    <h1 class="seccion__titulo">Cotizaciones recibidas (<%= cotizaciones.length %>)</h1>

    <% if (cotizaciones.length === 0) { %>
      <p>Todavía no hay cotizaciones registradas.</p>
    <% } else { %>
      <div class="admin__tabla-wrap">
        <table class="admin__tabla">
          <thead>
            <tr>
              <th>Fecha</th>
              <th>Nombre</th>
              <th>Teléfono</th>
              <th>Correo</th>
              <th>Servicio</th>
              <th>Descripción</th>
            </tr>
          </thead>
          <tbody>
            <% cotizaciones.forEach(function(c) { %>
              <tr>
                <td><%= new Date(c.creado_en).toLocaleString('es-CL') %></td>
                <td><%= c.nombre %></td>
                <td><a href="https://wa.me/<%= c.telefono.replace('+', '') %>" target="_blank"><%= c.telefono %></a></td>
                <td><a href="mailto:<%= c.correo %>"><%= c.correo %></a></td>
                <td><%= c.servicio_slug || '—' %></td>
                <td><%= c.descripcion %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </main>
</body>
</html>
