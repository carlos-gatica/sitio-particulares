<%- include('partials/top') %>

    <h1 class="seccion__titulo">Cotizaciones recibidas (<%= cotizaciones.length %>)</h1>

    <% if (cotizaciones.length === 0) { %>
      <p>Todavía no hay cotizaciones registradas.</p>
    <% } else { %>
      <div class="admin__tabla-wrap">
        <table class="admin__tabla">
          <thead>
            <tr>
              <th>Fecha</th>
              <th>Nombre</th>
              <th>Teléfono</th>
              <th>Correo</th>
              <th>Servicio</th>
              <th>Descripción</th>
            </tr>
          </thead>
          <tbody>
            <% cotizaciones.forEach(function(c) { %>
              <tr>
                <td><%= new Date(c.creado_en).toLocaleString('es-CL', { timeZone: 'America/Santiago' }) %></td>
                <td><%= c.nombre %></td>
                <td><a href="https://wa.me/<%= c.telefono.replace('+', '') %>" target="_blank" rel="noopener"><%= c.telefono %></a></td>
                <td><a href="mailto:<%= c.correo %>"><%= c.correo %></a></td>
                <td><%= (c.servicio_slug && nombresServicio[c.servicio_slug]) || c.servicio_slug || '—' %></td>
                <td class="admin__celda-texto"><%= c.descripcion %></td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>

<%- include('partials/bottom') %>
