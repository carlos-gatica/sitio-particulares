# --- Base de datos (Supabase) ---
DATABASE_URL=postgresql://usuario:password@host:5432/postgres

# --- Supabase Storage (fotos y videos del panel admin) ---
# Project Settings -> API: "Project URL" y la llave "service_role" (secreta, NUNCA en el navegador)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Opcional. Nombre del bucket (se crea solo la primera vez). Por defecto: media
SUPABASE_BUCKET=media

# --- Resend (correo) ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
NOTIFICATION_EMAIL_TO=tuempresa@ejemplo.cl
NOTIFICATION_EMAIL_FROM=cotizaciones@tudominio.cl

# --- CallMeBot (WhatsApp) ---
CALLMEBOT_PHONE=56912345678
CALLMEBOT_APIKEY=123456

# --- Panel de administración (login en /admin/login) ---
ADMIN_USER=admin
ADMIN_PASSWORD=cambia-esta-clave-por-una-larga
# Opcional pero recomendado: texto largo y aleatorio para firmar las sesiones.
# Si no lo pones, se deriva de usuario + clave (cambiar la clave cierra las sesiones).
SESSION_SECRET=

# --- General ---
PORT=3000
SITE_NAME=CARLOS GATICA CONSTRUCCIONES
